@* ===== Views/Incident/Details.cshtml ===== *@
@model Test.Models.Incident
@{
    ViewData["Title"] = Model.TicketNumber;
    var slaClass = Model.SLADueDate < DateTime.UtcNow ? "sla-breach" : Model.SLADueDate < DateTime.UtcNow.AddHours(2) ? "sla-warning" : "sla-ok";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="btn btn-secondary btn-sm mb-2"><i class="bi bi-arrow-left"></i> Back</a>
        <div class="page-title">Incident Details</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger" data-confirm="Delete this incident?"><i class="bi bi-trash"></i> Delete</button>
        </form>
    </div>
</div>

<div class="detail-header">
    <div class="ticket-number">@Model.TicketNumber</div>
    <div class="detail-title">@Model.Title</div>
    <div class="detail-meta">
        <span class="detail-meta-item"><span class="badge badge-@Model.Priority.ToString().ToLower()">@Model.Priority</span></span>
        <span class="detail-meta-item"><span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span></span>
        <span class="detail-meta-item"><i class="bi bi-tag"></i>@Model.Category</span>
        <span class="detail-meta-item"><i class="bi bi-person"></i>@(Model.ReportedBy ?? "Unknown")</span>
        <span class="detail-meta-item"><i class="bi bi-calendar"></i>@Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
        <span class="detail-meta-item @slaClass"><i class="bi bi-clock"></i>SLA: @Model.SLADueDate.ToLocalTime().ToString("MMM dd HH:mm")</span>
    </div>
</div>

<div class="detail-grid">
    <div>
        <div class="card mb-4">
            <div class="card-header"><div class="card-title">Description</div></div>
            <div class="card-body">
                <p style="line-height:1.6;white-space:pre-wrap">@Model.Description</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
        {
            <div class="card mb-4">
                <div class="card-header"><div class="card-title" style="color:var(--success)"><i class="bi bi-check-circle me-1"></i>Resolution Notes</div></div>
                <div class="card-body"><p style="line-height:1.6;white-space:pre-wrap">@Model.ResolutionNotes</p></div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header">
                <div class="card-title">Comments (@Model.Comments.Count)</div>
            </div>
            <div class="card-body">
                @if (Model.Comments.Any())
                {
                    <div class="comment-list mb-4">
                        @foreach (var c in Model.Comments.OrderBy(c => c.CreatedAt))
                        {
                            <div class="comment-item @(c.IsInternal ? "internal" : "")">
                                <div class="comment-meta">
                                    <div class="user-avatar" style="width:26px;height:26px;font-size:11px">@c.Author.Substring(0,1).ToUpper()</div>
                                    <span class="comment-author">@c.Author</span>
                                    <span class="comment-date">@c.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                    @if (c.IsInternal) { <span class="badge badge-warning" style="font-size:10px">Internal</span> }
                                </div>
                                <div class="comment-body">@c.Content</div>
                            </div>
                        }
                    </div>
                }
                <form asp-action="AddComment" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <textarea name="content" class="form-control" rows="3" placeholder="Add a comment..." required></textarea>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <label class="d-flex align-items-center gap-2" style="font-size:13px;cursor:pointer">
                            <input type="checkbox" name="isInternal" value="true" /> Internal note
                        </label>
                        <button type="submit" class="btn btn-primary btn-sm">Add Comment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div>
        <div class="card mb-4">
            <div class="card-header"><div class="card-title">Details</div></div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item"><div class="info-label">Assigned To</div><div class="info-value">@(Model.AssignedTo ?? "Unassigned")</div></div>
                    <div class="info-item"><div class="info-label">Category</div><div class="info-value">@Model.Category</div></div>
                    <div class="info-item"><div class="info-label">Affected System</div><div class="info-value">@(Model.AffectedSystem ?? "—")</div></div>
                    <div class="info-item"><div class="info-label">Updated</div><div class="info-value" style="font-size:12px">@Model.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</div></div>
                    @if (Model.ResolvedAt.HasValue)
                    {
                        <div class="info-item"><div class="info-label">Resolved At</div><div class="info-value" style="font-size:12px;color:var(--success)">@Model.ResolvedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")</div></div>
                    }
                    @if (Model.LinkedProblem != null)
                    {
                        <div class="info-item" style="grid-column:span 2">
                            <div class="info-label">Linked Problem</div>
                            <div class="info-value"><a asp-controller="Problem" asp-action="Details" asp-route-id="@Model.LinkedProblemId">@Model.LinkedProblem.TicketNumber</a></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
