@model Test.Models.Incident
@{
    ViewData["Title"] = $"Edit {Model.TicketNumber}";
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm mb-2"><i class="bi bi-arrow-left"></i> Back</a>
        <div class="page-title">Edit Incident</div>
        <div class="page-subtitle" style="font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--primary)">@Model.TicketNumber</div>
    </div>
</div>

<div class="card" style="max-width:720px">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Priority</label>
                    <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Test.Models.Priority>()"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Test.Models.IncidentStatus>()"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Test.Models.Category>()"></select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Assigned To</label>
                    <input asp-for="AssignedTo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Affected System</label>
                    <input asp-for="AffectedSystem" class="form-control" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Resolution Notes</label>
                <textarea asp-for="ResolutionNotes" class="form-control" rows="3" placeholder="Fill when resolving..."></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
