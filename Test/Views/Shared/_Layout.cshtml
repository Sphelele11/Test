<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ITSM Portal</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <div class="logo-icon"><i class="bi bi-shield-check"></i></div>
                <div>
                    <div class="logo-title">ITSM Portal</div>
                    <div class="logo-sub">IT Service Management</div>
                </div>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-welcome">
                <div class="sw-avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                <div class="sw-info">
                    <div class="sw-greeting">Welcome back,</div>
                    <div class="sw-name">@(User.Identity.Name?.Split('@')[0] ?? "User")</div>
                </div>
                <div class="sw-dot"></div>
            </div>
        }

        <nav class="sidebar-nav">
            <div class="nav-section-label">Overview</div>
            <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            <div class="nav-section-label">Service Operations</div>
            <a asp-controller="Incident" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Incident" ? "active" : "")">
                <i class="bi bi-exclamation-triangle"></i><span>Incidents</span>
            </a>
            <a asp-controller="Problem" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Problem" ? "active" : "")">
                <i class="bi bi-bug"></i><span>Problems</span>
            </a>
            <a asp-controller="Change" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Change" ? "active" : "")">
                <i class="bi bi-arrow-repeat"></i><span>Change Requests</span>
            </a>
            <a asp-controller="ServiceRequest" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ServiceRequest" ? "active" : "")">
                <i class="bi bi-clipboard-check"></i><span>Service Requests</span>
            </a>

            <div class="nav-section-label">Resources</div>
            <a asp-controller="Asset" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asset" ? "active" : "")">
                <i class="bi bi-hdd-stack"></i><span>Assets (CMDB)</span>
            </a>
            <a asp-controller="Knowledge" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Knowledge" ? "active" : "")">
                <i class="bi bi-book"></i><span>Knowledge Base</span>
            </a>

            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section-label">Administration</div>
                <a asp-controller="Admin" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="bi bi-speedometer"></i><span>Admin Dashboard</span>
                </a>
                <a asp-controller="Admin" asp-action="Users" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                    <i class="bi bi-people"></i><span>User Management</span>
                </a>
                <a asp-controller="Admin" asp-action="Reports" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-line"></i><span>Reports</span>
                </a>
                <a asp-controller="Admin" asp-action="AuditLog" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLog" ? "active" : "")">
                    <i class="bi bi-journal-text"></i><span>Audit Log</span>
                </a>
                <a asp-controller="Admin" asp-action="Settings" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="bi bi-sliders"></i><span>Settings</span>
                </a>
            }
        </nav>

        <div class="sidebar-footer">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-footer-links">
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="footer-link">
                        <i class="bi bi-person-circle"></i> My Profile
                    </a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="footer-link danger"><i class="bi bi-box-arrow-right"></i> Sign Out</button>
                    </form>
                </div>
            }
            <div class="sidebar-version">ITSM Portal v2.0 &middot; ASP.NET Core 8</div>
        </div>
    </div>

    <!-- Sidebar Overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">

        <!-- Top Bar -->
        <div class="topbar">
            <button class="btn-icon" id="sidebarToggle" title="Toggle sidebar">
                <i class="bi bi-list" style="font-size:20px"></i>
            </button>

            <div class="topbar-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search tickets, assets, articles..." id="globalSearch" autocomplete="off" />
            </div>

            <div class="topbar-right">
                <div class="dropdown">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="dropdown">
                        <i class="bi bi-plus-circle"></i> New
                        <i class="bi bi-chevron-down ms-1" style="font-size:10px"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width:210px">
                        <li><h6 class="dropdown-header" style="font-size:10px;text-transform:uppercase;letter-spacing:.07em">Create New</h6></li>
                        <li><a class="dropdown-item" asp-controller="Incident" asp-action="Create"><i class="bi bi-exclamation-triangle me-2 text-danger"></i>Incident</a></li>
                        <li><a class="dropdown-item" asp-controller="Problem" asp-action="Create"><i class="bi bi-bug me-2 text-warning"></i>Problem</a></li>
                        <li><a class="dropdown-item" asp-controller="Change" asp-action="Create"><i class="bi bi-arrow-repeat me-2 text-primary"></i>Change Request</a></li>
                        <li><a class="dropdown-item" asp-controller="ServiceRequest" asp-action="Create"><i class="bi bi-clipboard-check me-2 text-success"></i>Service Request</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Asset" asp-action="Create"><i class="bi bi-hdd me-2 text-secondary"></i>Asset</a></li>
                        <li><a class="dropdown-item" asp-controller="Knowledge" asp-action="Create"><i class="bi bi-book me-2" style="color:var(--info)"></i>KB Article</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <button class="btn-icon position-relative" data-bs-toggle="dropdown" title="Notifications">
                        <i class="bi bi-bell" style="font-size:18px"></i>
                        <span class="notif-badge" id="notifBadge" style="display:none">3</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notif-panel">
                        <div class="notif-header"><strong>Notifications</strong></div>
                        <div class="notif-item unread">
                            <div class="ni-icon red"><i class="bi bi-exclamation-triangle-fill"></i></div>
                            <div class="ni-body"><div class="ni-title">2 Critical Incidents</div><div class="ni-sub">Require immediate attention</div></div>
                        </div>
                        <div class="notif-item unread">
                            <div class="ni-icon amber"><i class="bi bi-clock-fill"></i></div>
                            <div class="ni-body"><div class="ni-title">SLA Breach Warning</div><div class="ni-sub">INC-0003 breaches in 45 min</div></div>
                        </div>
                        <div class="notif-item">
                            <div class="ni-icon green"><i class="bi bi-check-circle-fill"></i></div>
                            <div class="ni-body"><div class="ni-title">Change Approved</div><div class="ni-sub">CHG-0001 approved by Manager</div></div>
                        </div>
                        <div class="notif-footer"><a href="#">View all notifications</a></div>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="topbar-user-btn" data-bs-toggle="dropdown">
                            <div class="user-avatar-sm">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                            <span class="d-none d-md-inline" style="font-size:13.5px;font-weight:500">@(User.Identity.Name?.Split('@')[0])</span>
                            <i class="bi bi-chevron-down ms-1" style="font-size:10px;color:var(--text-muted)"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header" style="font-size:11px;font-weight:500">@User.Identity.Name</h6></li>
                            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-gear me-2"></i>Admin Panel</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-sm">Sign In</a>
                }
            </div>
        </div>

        <!-- Welcome Banner (Dashboard only) -->
        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
             ViewContext.RouteData.Values["action"]?.ToString() == "Index" &&
             User.Identity?.IsAuthenticated == true)
        {
            <div class="welcome-banner" id="welcomeBanner">
                <div class="wb-bg-pattern"></div>
                <div class="wb-content">
                    <div class="wb-left">
                        <div class="wb-eyebrow"><i class="bi bi-stars"></i> Service Desk Portal</div>
                        <div class="wb-greeting" id="wbGreeting">Good morning</div>
                        <div class="wb-name">@(User.Identity.Name?.Split('@')[0] ?? "User")! 👋</div>
                        <div class="wb-date" id="wbDate"></div>
                        <div class="wb-role-badges">
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="role-badge admin"><i class="bi bi-shield-fill-check"></i> Administrator</span>
                            }
                            else if (User.IsInRole("Agent"))
                            {

                                <span class="role-badge agent"><i class="bi bi-headset"></i> Support Agent</span>
                            }
                            else
                            {

                                <span class="role-badge user"><i class="bi bi-person-check-fill"></i> Portal User</span>
                            }
                            <span class="role-badge online"><i class="bi bi-circle-fill" style="font-size:7px"></i> Online</span>
                        </div>
                    </div>
                    <div class="wb-right">
                        <div class="ql-header">
                            <i class="bi bi-lightning-charge-fill"></i> Quick Actions
                        </div>
                        <div class="quick-links-grid">
                            <a asp-controller="Incident" asp-action="Create" class="ql-card red">
                                <div class="ql-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                                <div class="ql-label">New Incident</div>
                                <div class="ql-desc">Report an IT issue</div>
                            </a>
                            <a asp-controller="ServiceRequest" asp-action="Create" class="ql-card blue">
                                <div class="ql-icon"><i class="bi bi-clipboard-plus-fill"></i></div>
                                <div class="ql-label">Service Request</div>
                                <div class="ql-desc">Request IT services</div>
                            </a>
                            <a asp-controller="Change" asp-action="Create" class="ql-card purple">
                                <div class="ql-icon"><i class="bi bi-arrow-repeat"></i></div>
                                <div class="ql-label">Change Request</div>
                                <div class="ql-desc">Plan infrastructure change</div>
                            </a>
                            <a asp-controller="Knowledge" asp-action="Index" class="ql-card green">
                                <div class="ql-icon"><i class="bi bi-book-fill"></i></div>
                                <div class="ql-label">Knowledge Base</div>
                                <div class="ql-desc">Search self-help articles</div>
                            </a>
                            <a asp-controller="Asset" asp-action="Index" class="ql-card amber">
                                <div class="ql-icon"><i class="bi bi-hdd-stack-fill"></i></div>
                                <div class="ql-label">Asset Registry</div>
                                <div class="ql-desc">View CMDB assets</div>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Index" class="ql-card slate">
                                    <div class="ql-icon"><i class="bi bi-gear-fill"></i></div>
                                    <div class="ql-label">Admin Panel</div>
                                    <div class="ql-desc">System administration</div>
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Problem" asp-action="Index" class="ql-card slate">
                                    <div class="ql-icon"><i class="bi bi-bug-fill"></i></div>
                                    <div class="ql-label">View Problems</div>
                                    <div class="ql-desc">Known errors & fixes</div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
                <button class="wb-close" id="wbClose"><i class="bi bi-x-lg"></i></button>
            </div>
        }

        <div class="page-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>

        <footer class="page-footer">
            <span>&copy; @DateTime.Now.Year ITSM Portal — IT Service Management System</span>
            <span style="color:var(--text-muted)">Built with ASP.NET Core 8 &amp; Entity Framework</span>
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
